{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "factory/manifest.schema.json",
  "title": "Workflow manifest",
  "description": "Machine-readable state of one workflow: .factory/workflows/<id>/manifest.json. Transition rules are enforced by lib/state.mjs, not by this schema.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "title",
    "request",
    "mode",
    "status",
    "createdAt",
    "updatedAt",
    "providers",
    "tasks",
    "review",
    "validation",
    "issues",
    "artifacts",
    "history"
  ],
  "properties": {
    "schemaVersion": {
      "$ref": "factory/common.schema.json#/$defs/schemaVersion"
    },
    "id": {
      "$ref": "factory/common.schema.json#/$defs/workflowId"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "request": {
      "description": "The original user request, verbatim.",
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "$ref": "factory/common.schema.json#/$defs/workflowMode"
    },
    "status": {
      "$ref": "factory/common.schema.json#/$defs/workflowStatus"
    },
    "blockedOn": {
      "description": "Set while the workflow waits for something outside the agent's control. null when not waiting.",
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "kind",
        "detail"
      ],
      "properties": {
        "kind": {
          "enum": [
            "user_input",
            "user_approval",
            "discovery_session",
            "external_dependency",
            "escalation"
          ]
        },
        "detail": {
          "type": "string",
          "minLength": 1
        },
        "since": {
          "$ref": "factory/common.schema.json#/$defs/timestamp"
        }
      }
    },
    "createdAt": {
      "$ref": "factory/common.schema.json#/$defs/timestamp"
    },
    "updatedAt": {
      "$ref": "factory/common.schema.json#/$defs/timestamp"
    },
    "baseRef": {
      "description": "Git commit or branch the workflow started from.",
      "type": "string"
    },
    "classification": {
      "$ref": "factory/classification.schema.json"
    },
    "providers": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "discovery",
        "specification"
      ],
      "properties": {
        "discovery": {
          "$ref": "#/$defs/providerUse"
        },
        "specification": {
          "$ref": "#/$defs/providerUse"
        }
      }
    },
    "tasks": {
      "type": "array",
      "items": {
        "$ref": "factory/task.schema.json"
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attempts",
        "maxIterations",
        "history"
      ],
      "properties": {
        "attempts": {
          "type": "integer",
          "minimum": 0
        },
        "maxIterations": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "history": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "attempt",
              "kind",
              "reviewer",
              "outcome",
              "report"
            ],
            "properties": {
              "attempt": {
                "type": "integer",
                "minimum": 1
              },
              "kind": {
                "enum": [
                  "code",
                  "architecture"
                ]
              },
              "reviewer": {
                "type": "string",
                "minLength": 1
              },
              "outcome": {
                "enum": [
                  "APPROVED",
                  "APPROVED_WITH_WARNINGS",
                  "NEEDS_CHANGES",
                  "BLOCKED"
                ]
              },
              "independent": {
                "type": "boolean"
              },
              "report": {
                "$ref": "factory/common.schema.json#/$defs/relativePath"
              }
            }
          }
        }
      }
    },
    "validation": {
      "type": "array",
      "items": {
        "$ref": "factory/common.schema.json#/$defs/commandResult"
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "severity",
          "description",
          "status",
          "source"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^I[0-9]{1,3}$"
          },
          "severity": {
            "$ref": "factory/common.schema.json#/$defs/severity"
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "open",
              "resolved",
              "accepted_risk",
              "escalated"
            ]
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "taskId": {
            "$ref": "factory/common.schema.json#/$defs/taskId"
          }
        }
      }
    },
    "artifacts": {
      "description": "Artifact kind -> repository-relative path. Paths may point outside .factory/ (e.g. specs/, GLOSSARY.md, docs/adr/).",
      "type": "object",
      "propertyNames": {
        "enum": [
          "classification",
          "discoveryBrief",
          "discoverySummary",
          "glossary",
          "adrs",
          "spec",
          "plan",
          "planReview",
          "validationReport",
          "finalReport"
        ]
      },
      "additionalProperties": {
        "description": "A single path, or a list of paths (e.g. several ADRs).",
        "type": [
          "string",
          "array"
        ],
        "items": {
          "$ref": "factory/common.schema.json#/$defs/relativePath"
        },
        "pattern": "^(?!/)(?!.*(^|/)\\.\\.(/|$))[^\\0]+$"
      }
    },
    "history": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "at",
          "to",
          "reason"
        ],
        "properties": {
          "at": {
            "$ref": "factory/common.schema.json#/$defs/timestamp"
          },
          "from": {
            "$ref": "factory/common.schema.json#/$defs/workflowStatus"
          },
          "to": {
            "$ref": "factory/common.schema.json#/$defs/workflowStatus"
          },
          "modeChange": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "from",
              "to"
            ],
            "properties": {
              "from": {
                "$ref": "factory/common.schema.json#/$defs/workflowMode"
              },
              "to": {
                "$ref": "factory/common.schema.json#/$defs/workflowMode"
              }
            }
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "$defs": {
    "providerUse": {
      "description": "Records which provider was requested and which actually ran. Never claim a provider ran unless it did.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requested",
        "used",
        "status"
      ],
      "properties": {
        "requested": {
          "type": [
            "string",
            "null"
          ]
        },
        "used": {
          "description": "Provider that actually produced the artifacts; null if none ran.",
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "enum": [
            "not_applicable",
            "pending",
            "in_progress",
            "completed",
            "unavailable",
            "skipped_by_user"
          ]
        },
        "version": {
          "type": "string"
        },
        "evidence": {
          "description": "How usage was established (e.g. 'user invoked /grill-with-docs; GLOSSARY.md and docs/adr/0003 changed').",
          "type": "string"
        },
        "note": {
          "type": "string"
        }
      }
    }
  }
}
