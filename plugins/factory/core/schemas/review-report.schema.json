{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "factory/review-report.schema.json",
  "title": "Review report",
  "description": "Independent review outcome. Semantic rules (e.g. NEEDS_CHANGES requires a required finding) are enforced by lib/contracts.mjs.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "reviewer", "attempt", "outcome", "independence", "subject", "findings", "validationStatus"],
  "properties": {
    "schemaVersion": { "$ref": "factory/common.schema.json#/$defs/schemaVersion" },
    "workflowId": { "$ref": "factory/common.schema.json#/$defs/workflowId" },
    "kind": { "enum": ["code", "architecture"] },
    "reviewer": { "description": "Agent that performed the review.", "type": "string", "minLength": 1 },
    "attempt": { "type": "integer", "minimum": 1 },
    "outcome": { "enum": ["APPROVED", "APPROVED_WITH_WARNINGS", "NEEDS_CHANGES", "BLOCKED"] },
    "independence": {
      "description": "Whether the reviewer is a separate agent context from every implementer of the subject.",
      "type": "object",
      "additionalProperties": false,
      "required": ["independent", "implementedBy"],
      "properties": {
        "independent": { "type": "boolean" },
        "implementedBy": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "note": { "type": "string" }
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["taskIds"],
      "properties": {
        "taskIds": { "type": "array", "minItems": 1, "items": { "$ref": "factory/common.schema.json#/$defs/taskId" } },
        "files": { "$ref": "factory/common.schema.json#/$defs/stringList" },
        "baseRef": { "description": "Git ref the diff was taken against.", "type": "string" }
      }
    },
    "requirementsCoverage": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ref", "status"],
        "properties": {
          "ref": { "type": "string", "minLength": 1 },
          "status": { "enum": ["met", "partial", "not_met", "not_verifiable"] },
          "evidence": { "type": "string" }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "severity", "category", "description", "evidence", "required"],
        "properties": {
          "id": { "type": "string", "pattern": "^F[0-9]{1,3}$" },
          "severity": { "$ref": "factory/common.schema.json#/$defs/severity" },
          "category": { "enum": ["correctness", "requirements", "security", "testing", "error-handling", "maintainability", "conventions", "regression", "architecture", "performance", "scope"] },
          "description": { "type": "string", "minLength": 1 },
          "evidence": { "description": "file:line, command output, or quoted requirement.", "type": "string", "minLength": 1 },
          "required": { "description": "true = must be fixed before approval.", "type": "boolean" },
          "suggestedChange": { "type": "string" },
          "taskId": { "$ref": "factory/common.schema.json#/$defs/taskId" }
        }
      }
    },
    "recommendations": { "$ref": "factory/common.schema.json#/$defs/stringList" },
    "validationStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "enum": ["passed", "failed", "partial", "not_run"] },
        "commands": { "type": "array", "items": { "$ref": "factory/common.schema.json#/$defs/commandResult" } },
        "note": { "type": "string" }
      }
    },
    "blockedReason": { "type": "string" }
  }
}
